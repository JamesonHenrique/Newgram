# Copie para .env (nunca commite o .env com valores reais)
# DATABASE_URL=jdbc:postgresql://localhost:5432/newgram
# DATABASE_USERNAME=newgram
# DATABASE_PASSWORD=troque-esta-senha

# JWT: gere com `openssl rand -base64 32` (minimo 32 bytes)
# JWT_SECRET=

# AWS S3 (ou MinIO local via AWS_S3_ENDPOINT=http://localhost:9000)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=newgram-dev

# CORS extra (separado por virgula)
# APP_CORS_EXTRA=https://meu-dominio.com

# URL base do front (links de recuperacao de senha)
# APP_FRONT_URL=http://localhost:4200
