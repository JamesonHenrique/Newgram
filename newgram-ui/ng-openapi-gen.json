{
  "input": "http://localhost:8080/v3/api-docs",
  "output": "src/app/services",
  "ignoreUnusedModels": true,
  "skipJsonSuffix": true,
  "removeStaleFiles": true,
  "useSingletonProvider": false,
  "useAngularHttpClient": true,
  "responseType": "observable",
  "serviceSuffix": "Service",
  "modelSuffix": "",
  "fileNamingStyle": "kebab",
  "apiModule": false,
  "baseModule": false,
  "modelIndex": true,
  "serviceIndex": true,
  "enumIndex": true,
  "generateFormGroups": true,
  "generateModelInterfaces": true,
  "useOperationId": true,
  "typescriptThreePlus": true,
  "useHttpClientParams": true,
  "standalone": true
}