{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "midia",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "urls": ["https://**.amazonaws.com/**", "https://**.r2.cloudflarestorage.com/**"]
      },
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "10s"
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/images/**"]
      }
    }
  ]
}
